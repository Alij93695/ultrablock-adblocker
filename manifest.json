{
  "manifest_version": 3,
  "name": "UltraBlock - Universal Ad & Content Blocker",
  "version": "1.0.0",
  "description": "Blocks intrusive ads, popups, banners, and sponsored content across websites and video streaming platforms.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "UltraBlock Control Center"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules/rules.json"
      },
      {
        "id": "ruleset_ublock",
        "enabled": true,
        "path": "rules/ublock-filters.json"
      },
      {
        "id": "ruleset_easylist",
        "enabled": true,
        "path": "rules/easylist.json"
      }
    ]
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "content/youtube_main_world.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "content/youtube_adblock.js",
        "content/sponsor_skip.js"
      ],
      "css": [
        "content/injected_styles.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://localhost/*",
        "*://127.0.0.1/*",
        "*://0.0.0.0/*"
      ],
      "js": [
        "content/generic_adblock.js"
      ],
      "css": [
        "content/injected_styles.css"
      ],
      "run_at": "document_start"
    }
  ]
}